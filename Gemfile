source "https://rubygems.org"

# Jekyll core
gem "jekyll", "~> 4.3"

# Markdown + syntax highlighting (matches _config.yml settings)
gem "kramdown-parser-gfm"
gem "rouge"

# Required on Ruby 3.0+ where webrick is no longer bundled
gem "webrick"

# Tzinfo timezone data on Windows / non-glibc platforms
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
